{
	"name": "emdash-plugin-linguadash",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"astro-component",
		"multilingual",
		"translation",
		"i18n"
	],
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./astro": "./astro/index.ts"
	},
	"files": [
		"dist",
		"astro",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=0.12.0",
		"astro": ">=6.0.0"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		}
	},
	"devDependencies": {
		"@emdash-cms/blocks": "0.39.1",
		"@emdash-cms/plugin-cli": "0.12.0",
		"@emdash-cms/plugin-test": "^0.2.1",
		"emdash": "0.39.1",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
