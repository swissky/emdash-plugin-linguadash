{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": [
		"src/**/*",
		"tests/**/*",
		"vitest.config.ts",
		"astro/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"astro/index.ts"
	]
}
