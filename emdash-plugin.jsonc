{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "linguadash",
	"publisher": "did:plc:3bsmtjuqmxef56ezy4m52azr",

	"license": "MIT",
	"author": { "name": "swissky", "url": "https://github.com/swissky" },
	"security": { "url": "https://github.com/swissky/emdash-plugin-linguadash/security/advisories/new" },
	"name": "LinguaDash",
	"keywords": ["translation", "multilingual", "i18n", "deepl", "seo"],
	"sections": {
		"description": { "file": "registry/description.md" },
		"installation": { "file": "registry/installation.md" }
	},
	"release": {
		"requires": { "env:emdash": ">=1.0.0" },
		"artifacts": {
			"icon": { "file": "icon.png" },
			"screenshots": [{ "file": "assets/screenshot-status.png" }, { "file": "assets/screenshot-editor.png" }]
		}
	},
	"description": "Translate EmDash content and SEO fields with DeepL, Google, Azure or AI models, and see which entries are missing, outdated or need review.",
	"repo": "https://github.com/swissky/emdash-plugin-linguadash",

	// Trust contract — what runtime APIs the plugin asks for.
	// Changing these between releases requires a version bump because
	// installed users have consented to the old contract.
	"capabilities": ["content:write", "content:revisions:read", "schema:read", "network:request"],
	"allowedHosts": [
		"api.deepl.com",
		"api-free.deepl.com",
		"translation.googleapis.com",
		"api.cognitive.microsofttranslator.com",
		"api.openai.com",
		"api.cloudflare.com"
	],
	"storage": {
		"status": { "indexes": ["collection", "targetLocale", "state", "sourceId", "outdated", ["state", "outdated"]] }
	},

	"admin": {
		"pages": [{ "path": "/translations", "label": "Translations", "icon": "translate" }],
		"settingsSchema": {
			"targetLocales": {
				"type": "string",
				"label": "Target languages",
				"description": "Comma-separated locale codes to translate into, e.g. fr, it, en."
			},
			"provider": {
				"type": "select",
				"label": "Machine translation",
				"description": "Adds a translate button to the Translation status panel. Machine translations are saved as drafts to review.",
				"options": [
					{ "value": "none", "label": "Off" },
					{ "value": "deepl", "label": "DeepL" },
					{ "value": "google", "label": "Google Cloud Translation" },
					{ "value": "azure", "label": "Azure Translator" },
					{ "value": "openai", "label": "OpenAI (GPT)" },
					{ "value": "cloudflare", "label": "Cloudflare AI Gateway" }
				],
				"default": "none"
			},
			"deeplApiKey": {
				"type": "secret",
				"label": "DeepL API key",
				"description": "Free keys end in :fx and use the DeepL Free API."
			},
			"deeplGlossaryIds": {
				"type": "string",
				"label": "DeepL glossary IDs",
				"description": "Up to 5 glossary IDs, separated by commas. Each translation uses the glossaries that have a dictionary for its language pair."
			},
			"googleApiKey": {
				"type": "secret",
				"label": "Google Cloud API key",
				"description": "A key for a Google Cloud project with the Cloud Translation API enabled."
			},
			"azureApiKey": { "type": "secret", "label": "Azure Translator key" },
			"azureRegion": {
				"type": "string",
				"label": "Azure region",
				"description": "The region of the Translator resource, such as westeurope. Leave empty for a global resource."
			},
			"openaiApiKey": { "type": "secret", "label": "OpenAI API key" },
			"openaiModel": { "type": "string", "label": "OpenAI model", "default": "gpt-4.1-mini" },
			"cloudflareAccountId": {
				"type": "string",
				"label": "Cloudflare account ID",
				"description": "The 32-character ID shown in the Cloudflare dashboard sidebar."
			},
			"cloudflareApiToken": {
				"type": "secret",
				"label": "Cloudflare API token",
				"description": "Needs the Account > Workers AI > Read permission."
			},
			"cloudflareGatewayId": {
				"type": "string",
				"label": "AI Gateway ID",
				"description": "Requests go through this gateway for logging, caching and rate limits.",
				"default": "default"
			},
			"cloudflareModel": {
				"type": "string",
				"label": "Cloudflare model",
				"description": "A Workers AI model such as @cf/meta/llama-3.3-70b-instruct-fp8-fast, or a gateway model such as openai/gpt-4.1-mini (billed through Unified Billing).",
				"default": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
			},
			"formality": {
				"type": "select",
				"label": "Tone",
				"options": [
					{ "value": "default", "label": "Default" },
					{ "value": "more", "label": "Formal" },
					{ "value": "less", "label": "Informal" }
				],
				"default": "default"
			},
			"instructions": {
				"type": "string",
				"label": "Instructions for the translation",
				"description": "Optional guidance for DeepL and AI models, such as spelling conventions or terms to keep untranslated. For DeepL, write one instruction per line."
			}
		},
		"editorPanels": [
			{
				"id": "translations",
				"title": "Translation status",
				"route": "editor/panel"
			}
		]
	}
}
