{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "linguadash",
	"publisher": "did:plc:3bsmtjuqmxef56ezy4m52azr",

	"license": "MIT",
	"author": { "name": "swissky", "url": "https://github.com/swissky" },
	"security": { "url": "https://github.com/swissky/emdash-plugin-linguadash/security/advisories/new" },
	"description": "Multilingual content for EmDash: translate posts, pages and taxonomies manually or automatically with DeepL or GPT, and track translation status.",
	"repo": "https://github.com/swissky/emdash-plugin-linguadash",

	// Trust contract — what runtime APIs the plugin asks for.
	// Changing these between releases requires a version bump because
	// installed users have consented to the old contract.
	"capabilities": ["content:write", "content:revisions:read", "schema:read", "network:request"],
	"allowedHosts": ["api.deepl.com", "api-free.deepl.com", "api.openai.com", "api.cloudflare.com"],
	"storage": {
		"status": { "indexes": ["collection", "targetLocale", "state", "sourceId", "outdated", ["state", "outdated"]] }
	},

	"admin": {
		"pages": [{ "path": "/translations", "label": "Translations" }],
		"settingsSchema": {
			"sourceLocale": {
				"type": "string",
				"label": "Source language",
				"description": "Locale code translations are made from, e.g. de. Leave empty to use the site's default locale."
			},
			"targetLocales": {
				"type": "string",
				"label": "Target languages",
				"description": "Comma-separated locale codes to translate into, e.g. fr, it, en."
			},
			"provider": {
				"type": "select",
				"label": "Machine translation",
				"description": "Adds a translate button to the Translations panel. Machine translations are saved as drafts to review.",
				"options": [
					{ "value": "none", "label": "Off" },
					{ "value": "deepl", "label": "DeepL" },
					{ "value": "openai", "label": "OpenAI (GPT)" },
					{ "value": "cloudflare", "label": "Cloudflare AI Gateway" }
				],
				"default": "none"
			},
			"deeplApiKey": {
				"type": "secret",
				"label": "DeepL API key",
				"description": "Free keys end in :fx and use the DeepL Free API."
			},
			"openaiApiKey": { "type": "secret", "label": "OpenAI API key" },
			"openaiModel": { "type": "string", "label": "OpenAI model", "default": "gpt-4.1-mini" },
			"cloudflareAccountId": {
				"type": "string",
				"label": "Cloudflare account ID",
				"description": "The 32-character ID shown in the Cloudflare dashboard sidebar."
			},
			"cloudflareApiToken": {
				"type": "secret",
				"label": "Cloudflare API token",
				"description": "Needs the Account > Workers AI > Read permission."
			},
			"cloudflareGatewayId": {
				"type": "string",
				"label": "AI Gateway ID",
				"description": "Requests go through this gateway for logging, caching and rate limits.",
				"default": "default"
			},
			"cloudflareModel": {
				"type": "string",
				"label": "Cloudflare model",
				"description": "A Workers AI model such as @cf/meta/llama-3.3-70b-instruct-fp8-fast, or a gateway model such as openai/gpt-4.1-mini (billed through Unified Billing).",
				"default": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
			},
			"formality": {
				"type": "select",
				"label": "Tone",
				"options": [
					{ "value": "default", "label": "Default" },
					{ "value": "more", "label": "Formal" },
					{ "value": "less", "label": "Informal" }
				],
				"default": "default"
			}
		},
		"editorPanels": [
			{
				"id": "translations",
				"title": "Translations",
				"route": "editor/panel",
				"collections": ["posts", "pages"]
			}
		]
	}
}
